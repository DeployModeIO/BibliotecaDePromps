{
  "name": "biblioteca-de-promps-industriales",
  "version": "3.2.0",
  "private": true,
  "description": "Biblioteca profesional de mega-prompts industriales para generar aplicaciones completas con IA.",
  "license": "MIT",
  "scripts": {
    "lint": "eslint js/",
    "lint:fix": "eslint js/ --fix",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html,md}\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "validate": "npm run lint && npm run test"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "jest": "^29.7.0"
  }
}
